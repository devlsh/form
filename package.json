{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@devlsh/form",
  "version": "1.1.0",
  "description": "Lightweight, type-safe forms for Vue.",
  "keywords": [
    "async-validator",
    "composable",
    "form",
    "typescript",
    "validation",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/devlsh/form#readme",
  "bugs": {
    "url": "https://github.com/devlsh/form/issues"
  },
  "license": "MIT",
  "author": {
    "name": "devlsh",
    "email": "contact@devlsh.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlsh/form.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/devlsh"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "demo": "pnpm --filter form-demo",
    "fix:all": "pnpm lint:fix && pnpm fmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "prepack": "pnpm build",
    "prepare": "lefthook install --force",
    "test": "pnpm run test:setup && vitest run",
    "test:coverage": "pnpm run test:setup && vitest run --coverage",
    "test:setup": "playwright install chromium",
    "test:watch": "pnpm run test:setup && vitest watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "async-validator": "4.2.5"
  },
  "devDependencies": {
    "@devlsh/tools": "1.1.0",
    "@oxlint/plugins": "1.86.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/browser-playwright": "5.0.3",
    "lefthook": "2.1.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "vitest-browser-vue": "3.1.0",
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    }
  }
}
